{
  "name": "linkr-audio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --turbopack",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint",
    "deploy": "bun --bun opennextjs-cloudflare build && bun --bun opennextjs-cloudflare deploy -- --keep-vars",
    "upload": "bun --bun opennextjs-cloudflare build && bun --bun opennextjs-cloudflare upload",
    "preview": "bun --bun opennextjs-cloudflare build && bun --bun opennextjs-cloudflare preview",
    "cf-typegen": "bun --bun wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "typegen": "bun --bun openapi-typescript ../api/openapi.json -o ./src/lib/schema.d.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.4.0",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@opennextjs/cloudflare": "1.19.11",
    "@scidsgn/std": "^0.1.0",
    "jose": "^6.2.3",
    "next": "16.3.8",
    "posthog-js": "^1.390.2",
    "react": "19.2.7",
    "react-color-palette": "^7.3.1",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.79.0",
    "react-responsive": "^10.0.1",
    "sonner": "^2.0.7",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.27",
    "@types/react": "^19",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4",
    "typescript": "^6",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.102.0"
  }
}
